{
    "name": "@agent-tui/agent-tui",
    "version": "0.1.220-alpha.4",
    "description": "Bring Agent TUI into your terminal",
    "license": "Apache-2.0",
    "bin": {
        "agent-tui": "bin/agent-tui"
    },
    "files": [
