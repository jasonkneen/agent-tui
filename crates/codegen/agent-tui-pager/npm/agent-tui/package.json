        "node": ">=20"
    },
    "dependencies": {
        "@iarna/toml": "^3.0.0"
    },
    "optionalDependencies": {
        "@agent-tui/agent-tui-darwin-arm64": "0.1.220-alpha.4",
        "@agent-tui/agent-tui-darwin-x64": "0.1.220-alpha.4",
        "@agent-tui/agent-tui-linux-arm64": "0.1.220-alpha.4",
        "@agent-tui/agent-tui-linux-x64": "0.1.220-alpha.4",
        "@agent-tui/agent-tui-win32-arm64": "0.1.220-alpha.4",
        "@agent-tui/agent-tui-win32-x64": "0.1.220-alpha.4"
    }
}
